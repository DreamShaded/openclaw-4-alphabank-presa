{
  "name": "slidev-theme-sber",
  "version": "0.0.0",
  "type": "module",
  "keywords": [
    "slidev-theme",
    "slidev"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "slidev build example.md",
    "dev": "slidev example.md --open",
    "export": "slidev export example.md",
    "screenshot": "slidev export example.md --format png"
  },
  "dependencies": {
    "@slidev/types": "^52.6.0"
  },
  "devDependencies": {
    "@slidev/cli": "^52.6.0"
  },
  "//": "Learn more: https://sli.dev/guide/write-theme.html",
  "slidev": {
    "extends": "@slidev/theme-default",
    "colorSchema": "both",
    "setupFilePath": "./setup/index.ts",
    "defaults": {
      "fonts": {
        "sans": "SB Sans Text",
        "mono": "SB Sans Text"
      }
    }
  }
}